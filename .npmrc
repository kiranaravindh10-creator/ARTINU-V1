# Deliberately NOT engine-strict.
#
# @supabase/* declares node >=22, but the app only loads it when DATA_DRIVER is
# set to supabase — the default is an in-memory store, so a demo on Node 20 never
# reaches that code. engine-strict turns npm's advisory warning into a hard
# install failure whose message names @supabase/auth-js, which tells the person
# reading it nothing. `npm run doctor` and the predev preflight check the version
# instead, in words, at the moment it actually matters.

# Workspaces hoist to the root node_modules; keep that predictable.
install-links=false
