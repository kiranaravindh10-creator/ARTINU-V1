{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "installCommand": "npm install",
  "framework": null,
  "redirects": [
    {
      "source": "/artists/siya.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/artists/ayush.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/artists/kiran.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/artists/oum.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/artists/alen.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|image/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
