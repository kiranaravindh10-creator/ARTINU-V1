{
  "name": "artinu",
  "private": true,
  "version": "1.0.0",
  "description": "ARTINU — photography on rotation for real spaces. React + Express + Supabase.",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "preinstall": "node scripts/only-npm.mjs",
    "preflight": "node scripts/preflight.mjs",
    "predev": "npm run preflight",
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "dev:demo": "node scripts/dev-demo.mjs",
    "prebuild": "npm run preflight",
    "build": "npm run typecheck && npm run sitemap && npm run build --workspace client",
    "start": "npm run start --workspace server",
    "typecheck": "npm run typecheck --workspace shared && npm run typecheck --workspace server && npm run typecheck --workspace client && tsc -p tsconfig.edge.json",
    "seed": "npm run seed --workspace server",
    "package": "node scripts/package-zip.mjs",
    "doctor": "node scripts/preflight.mjs",
    "e2e": "node scripts/e2e-check.mjs",
    "check:welcome": "node scripts/welcome-email-check.mjs",
    "check:schema": "npm run check:schema --workspace server",
    "create:staff": "npm run create:staff --workspace server",
    "demo:sync": "npm run demo:sync --workspace server",
    "clean": "node -e \"const{rmSync}=require('fs');for(const d of ['node_modules','client/node_modules','server/node_modules','shared/node_modules'])rmSync(d,{recursive:true,force:true})\"",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "favicons": "node scripts/generate-favicons.mjs",
    "create:test-partners": "npm run create:test-partners --workspace server",
    "images": "node scripts/generate-images.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "packageManager": "npm@10.9.0"
}
