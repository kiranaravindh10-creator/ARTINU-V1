# ─────────────────────────────────────────────────────────────
# ARTINU — environment
# Copy to .env at the repo root. Everything below is optional:
# with no values set the API runs on the in-memory store with a
# local auth driver and seeded demo data, so `npm run dev` works
# out of the box.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# ── Data layer ────────────────────────────────────────────────
# memory | supabase   (memory = seeded in-process store, no network)
DATA_DRIVER=memory

# Fill an empty database with the demo dataset on boot.
# Unset it follows the driver: the memory store seeds, a real database does not.
# Set to true only when you actually want 31 fictional users and 140 sample
# artworks — never against a production Supabase project.
# SEED_DEMO_DATA=false

# ── Supabase (required only when DATA_DRIVER=supabase) ────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth ──────────────────────────────────────────────────────
# local | supabase   (supabase is not implemented; the value is ignored)
AUTH_DRIVER=local
# REQUIRED IN PRODUCTION. This signs every session token — anyone who knows it
# can mint a token for any account, including a CEO one. The API refuses to
# boot with NODE_ENV=production if this still looks like a placeholder or is
# under 32 characters. Generate a real one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-in-production-please-use-32-chars-min
JWT_EXPIRES_IN=7d

# ── Storage ───────────────────────────────────────────────────
# local | supabase | cloudinary | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/uploads

# Cloudinary (when STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# S3 (when STORAGE_DRIVER=s3)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# ── Email ─────────────────────────────────────────────────────
# Transport: auto | sendgrid | smtp | console
#   auto     SendGrid if SENDGRID_API_KEY is set, else SMTP, else console.
#   console  Captures mail without delivering it. Use in staging.
MAIL_PROVIDER=auto

# The From header, used by whichever transport is active. This address (or its
# domain) MUST be authenticated in SendGrid or delivery is rejected outright.
MAIL_FROM="Artinu <hello@artinu.in>"
# Optional — where replies go, if not the From address.
# MAIL_REPLY_TO=hello@artinu.in

# SendGrid. SERVER-ONLY SECRET. Never prefix with VITE_, never commit it.
# This key can send mail as the entire artinu.in domain.
SENDGRID_API_KEY=

# SMTP — the alternative transport. Leave blank when using SendGrid.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Legacy sender; MAIL_FROM wins when both are set.
SMTP_FROM="Artinu <hello@artinu.in>"

# Optional blind archive copy of every outgoing message. Leave unset in
# production: it doubles the send count against the monthly allowance and puts
# one-time codes and reset links in a second inbox.
# MAIL_ARCHIVE=
# Messages the plan allows per calendar month. Raise this to match your
# SendGrid plan — the default reserves the last 150 for sign-in codes.
# MAIL_MONTHLY_LIMIT=3000

# ── Payments ──────────────────────────────────────────────────
# mock_qr | razorpay | stripe
PAYMENT_PROVIDER=mock_qr
PAYMENT_UPI_VPA=artinu@upi
PAYMENT_PAYEE_NAME=ARTINU
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Google Drive Mirror (service account) ─────────────────────
# Unrelated to sign-in: this is only for the deprecated Drive → Firebase
# storage migration script. Leave blank unless you are running it.
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ── Authentication ────────────────────────────────────────────
# Email + ARTINU password only. There is no social sign-in: no Google,
# no Apple, no Facebook. Nothing Supabase-related is shipped to the
# browser any more, so there are no VITE_SUPABASE_* variables.

# ── Client (Vite) ─────────────────────────────────────────────
VITE_API_URL=http://localhost:4000/api
